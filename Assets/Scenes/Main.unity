  m_Script: {fileID: 11500000, guid: 708d2baf6b11990488a760befd839b69, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MeleeState
  calculateMeleeDamage:
    formula: 'Math.Max(0,

      ((i_STR + g_e*2 + i_MDMG  < 2 * t_MDR) ?

      (int)Math.Floor((i_STR
      + 2 + i_MDMG - t_MDR)/10) :

      (i_STR + g_e*2 + i_MDMG - t_MDR)))'
    instruction: 
    dataAssets:
    - {fileID: 1569542970}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    names:
    - Calculated
    - Initiator
    - Target
  calculateMeleeAccuracy:
    formula: "(c_pawnDistance > g_MeleeDST ? -2 :\nc_AttackerMovesToSkip > 0 ? -5
      :\nc_isWallsBetween > 0 ? -1 :\nc_AttackerMeleeAmount > 0.5 ? -3 :\nc_AttackerShotAmount
      > 0.5 ? -4 :\nMath.Max(g_M, Math.Min(100 - g_M, \n(i_DX + i_BRW + (c_AttackerIsShootOnMove
      > 0.1 ? 1 : 4)) * g_M\n)) / 100\n)"
    instruction: 
    dataAssets:
    - {fileID: 1569542970}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    names:
    - Calculated
    - Initiator
    - Target
  tooFarCode: -2
  exitCodes:
  - message: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E"
