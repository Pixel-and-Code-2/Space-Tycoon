  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b39d12fa46643894ab88592e56454a38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClickableItemsController
  mainTaskScenario:
  - selectable: {fileID: 1175933377}
    status: 1
    readyWhen: []
    doneWhen: []
    textToShow:
    - showTime: 0
      text: "\u041D\u0430 \u044D\u0442\u043E\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0417.\u0410.\u042F.
        - \u043E\u043D \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
        \u043B\u044E\u0431\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043C\u043E\u0436\u0435\u0442 \u0434\u0435\u043B\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
        \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0435\u0433\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0438 \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      completeSounds:
      - clip: {fileID: 8300000, guid: 39c7a81debe20734f9c64e7cc8aceb88, type: 3}
        authorIndex: 1
      - clip: {fileID: 8300000, guid: 39c7a81debe20734f9c64e7cc8aceb88, type: 3}
        authorIndex: 2
    - showTime: 2
      text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435,
        \u0430 \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \u0435\u0441\u0442\u044C
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C.
        \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      completeSounds: []
    shortLevelName: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0430"
    completeText: Yay!
    completeTextColor: {r: 0, g: 1, b: 0, a: 1}
  - selectable: {fileID: 4580301832448339888}
    status: 0
    readyWhen:
    - itemIndex: 0
      requiredStatus: 3
      isMain: 1
      atLeast: 0
    doneWhen: []
    textToShow:
    - showTime: 2
      text: "\u0412\u0441\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0430 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u044B,
        \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0432 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438, \u043E\u043D\u0430
        \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.
        \u041D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u043F\u0438\u0442\u0430\u043D\u0438\u0435, \u043F\u043E\u043A\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044F
        \u0435\u0449\u0451 \u043D\u0435 \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0430\u0434\u0430\u0442\u044C."
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      completeSounds: []
    shortLevelName: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0443"
    completeText: "\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430
