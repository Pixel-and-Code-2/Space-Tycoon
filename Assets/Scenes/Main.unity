    textToShow:
    - showTime: 2
      text: "\u0414\u0430\u0436\u0435 \u0432\u0434\u0430\u043B\u0438 \u043E\u0442
        \u0420\u043E\u0434\u0438\u043D\u044B \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440
        \u0418\u043B\u044C\u0438\u0447 \u0438 \u0418\u043E\u0441\u0438\u0444 \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043E\u043D\u043E\u0432\u0438\u0447,
        \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
        \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u0430\u0440\u0442\u0438\u044F
        \u043D\u0430\u043C\u0438 \u0433\u043E\u0440\u0434\u0438\u0442\u0441\u044F.
        \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C
        \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C \u0438 \u043C\u044B \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F
        \u043D\u0430 \u0420\u043E\u0434\u0438\u043D\u0443."
