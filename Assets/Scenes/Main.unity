    textToShow:
    - showTime: 2
      text: "\u0422\u0443\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
        \u0432\u0438\u0441\u0438\u0442 \u043D\u0435\u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
        \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442 \u044D\u043A\u0438\u043F\u0430\u0436\u0430
        \u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u041E\u043D\u0438 \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
        \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u043F\u043E\u043C\u043E\u0449\u0438,
        \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
        \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
        \u043E\u043F\u0430\u0441\u043D\u044B\u043C, \u043D\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438.  "
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
