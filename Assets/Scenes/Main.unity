--- !u!114 &1569542976
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1569542967}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb3c5f5ce8970974b9e518c00daeaa5a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShootState
  calculateShootDamage:
    formula: 'Math.Max(0,

      (((float)Math.Round(g_Random * (i_MAXDMG-i_MINDMG)
      + i_MINDMG)  < 2 * t_DR) ?

      (int)Math.Floor((g_Random * (i_MAXDMG-i_MINDMG)
      + i_MINDMG)/10) :

      (g_Random * (i_MAXDMG-i_MINDMG) + i_MINDMG - t_DR+(int)Math.Floor((t_DR
      )/10))

      ))'
    instruction: 
    dataAssets:
    - {fileID: 1569542970}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    names:
    - Calculated
    - Initiator
    - Target
  calculateShootAccuracy:
    formula: "(c_AttackerMovesToSkip > 0.5 ? -4 : \n(c_AttackerMeleeAmount > 0.5
      ? -5 :\n(c_isWallsBetween > 0.5 ? -1 : \n(c_AttackerAvailableAmmo < 0.5 ? -2
      :\n(c_AttackerCurrentMag < 0.5 ? -3 :\nMath.Max(g_M, Math.Min(100-g_M,\n\n((c_AttackerShotAmount
      > 0.5) ?\n    ((c_AttackerIsShootOnMove < 0.5) ?\n        ((i_DX\n         
      + i_SHT\n          - (int)(2.5 * Math.Log((c_pawnDistance-0.2)/1.9))\n         
      - (int)(2.5 * Math.Log((c_PreyWalkedDistance-0.2)/1.9))\n          - i_RCL\n         
      + 3\n        )* g_M)\n    :\n        ((i_DX\n          + i_SHT\n          -
      (int)(2.5 * Math.Log((c_pawnDistance-0.2)/1.9))\n          - (int)(2.5 * Math.Log((c_PreyWalkedDistance-0.2)/1.9))\n         
      - i_RCL\n          - i_BULK\n          - i_BULK * (float)Math.Round(Math.Min(\n             
      Math.Abs(c_targetAngle - c_lastShotAngle),\n              360 - Math.Abs(c_targetAngle
      - c_lastShotAngle)\n          )/15)\n          + 3\n        )* g_M))\n:\n   
      ((c_AttackerIsShootOnMove < 0.5) ?\n        ((i_DX\n          + i_SHT\n         
      - (int)(2.5 * Math.Log((c_pawnDistance-0.2)/1.9))\n          - (int)(2.5 *
      Math.Log((c_PreyWalkedDistance-0.2)/1.9))\n          + 3\n        )* g_M)\n   
      :\n        ((i_DX\n          + i_SHT\n          - (int)(2.5 * Math.Log((c_pawnDistance-0.2)/1.9))\n         
      - (int)(2.5 * Math.Log((c_PreyWalkedDistance-0.2)/1.9))\n          - i_BULK\n         
      + 3\n        ) * g_M))\n\n)))/100\n)))))"
    instruction: 
    dataAssets:
    - {fileID: 1569542970}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    names:
    - Calculated
    - Initiator
    - Target
  exitCodes:
  - message: "\u0426\u0435\u043B\u044C \u043D\u0435\u0434\u043E\u0441\u044F\u0433\u0430\u0435\u043C\u0430"
    color: {r: 1, g: 0, b: 0, a: 0.627451}
    code: -1
  - message: "\u041D\u0435\u0442\u0443 \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u044F"
    color: {r: 1, g: 0, b: 0, a: 0.627451}
    code: -2
  - message: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043F\u0443\u0441\u0442"
    color: {r: 1, g: 0, b: 0, a: 0.627451}
    code: -3
  - message: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u0445\u043E\u0434\u0430"
    color: {r: 1, g: 0, b: 0, a: 0.627451}
    code: -4
  - message: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u0431\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u0435\u043D"
    color: {r: 1, g: 0, b: 0, a: 0.627451}
    code: -5
  calculateShootDefense:
    formula: '( c_PreyDefenses < 0.5 ?

      (t_DDG + 0) * g_M :

      0)'
    instruction: "Type a mathematical expression using common '+', '-', '*', '/',
      '(', ')'.\nYou also can provide variables from Data Assets available in this
      object, using words like 'g_Statname' - the full list of available vars is
      listed below.\nEverything starting with '//' till the end of the line will
      be ignored as well as between those two: '/*', '*/'.\nYou also can use Math
      C# library, for example: Math.Abs(-g_someglobalstat).\nList of math formuls:
      Abs, Ceiling, Floor, Round, Pow, Sqrt, Sin, Cos, Tan (which use radians), Min,
      Max, Log. Also you can use: 'Math.PI' and 'Math.E'.\nClick the available variable
      below to add its name to the end o\u0430 the formula (but be sure to the formula
      to be blured when clicked)."
    dataAssets:
    - {fileID: 1569542970}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
    - {fileID: 11400000, guid: cc0d7718186f99944bd1a02642224a2e, type: 2}
