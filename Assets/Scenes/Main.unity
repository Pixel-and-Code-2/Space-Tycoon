--- !u!114 &1569542980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1569542967}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b39d12fa46643894ab88592e56454a38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClickableItemsController
  mainTaskScenario:
  - selectable: {fileID: 1175933377}
    status: 0
    readyWhen:
    - itemIndex: 10
      requiredStatus: 3
      isMain: 0
      atLeast: 0
    doneWhen: []
    textToShow:
    - showTime: 2
      text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0441 \u0441\u0442\u0430\u043B\u043E
        \u0431\u043E\u043B\u044C\u0448\u0435, \u0430 \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
        \u0435\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
        \u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C.
        \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
        \u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: -1
      completeSounds:
      - clip: {fileID: 8300000, guid: 9c824be1e25ec1242a0836aca94c91eb, type: 3}
        authorIndex: 1
      - clip: {fileID: 8300000, guid: 9c824be1e25ec1242a0836aca94c91eb, type: 3}
        authorIndex: 2
    shortLevelName: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0430"
    completeText: Yay!
    completeTextColor: {r: 0, g: 1, b: 0, a: 1}
    onlyShowText: 0
    startImmediately: 0
  - selectable: {fileID: 4580301832448339888}
    status: 0
    readyWhen:
    - itemIndex: 11
      requiredStatus: 3
      isMain: 0
      atLeast: 0
    doneWhen: []
    textToShow:
    - showTime: 2
      text: "\u0412\u0441\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0430 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u044B,
        \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0432 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438, \u043E\u043D\u0430
        \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.
        \u041D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u043F\u0438\u0442\u0430\u043D\u0438\u0435, \u043F\u043E\u043A\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044F
        \u0435\u0449\u0451 \u043D\u0435 \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0430\u0434\u0430\u0442\u044C."
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: -1
      completeSounds:
      - clip: {fileID: 8300000, guid: 3c592b22f5669c44f9a435ee8ccaf93f, type: 3}
        authorIndex: 0
      - clip: {fileID: 8300000, guid: f4a5693460525014685fa371e783c5d9, type: 3}
        authorIndex: 1
      - clip: {fileID: 8300000, guid: f4a5693460525014685fa371e783c5d9, type: 3}
        authorIndex: 2
    - showTime: 2
      text: "\u2014 \u0422\u043E\u0433\u0434\u0430 \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443!
        \u041F\u043E\u043A\u0430 \u043D\u0435 \u0443\u043F\u0430\u043B\u0430!"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: 2
      completeSounds: []
    shortLevelName: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0443"
    completeText: "\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0430"
    completeTextColor: {r: 0, g: 1, b: 0, a: 1}
    onlyShowText: 0
    startImmediately: 0
  - selectable: {fileID: 1878437268}
    status: 0
    readyWhen:
    - itemIndex: 12
      requiredStatus: 3
      isMain: 0
      atLeast: 0
    doneWhen: []
    textToShow:
    - showTime: 2
      text: "\u0427\u0451\u0440\u0442! \u0428\u043B\u044E\u0437 \u0437\u0430\u043A\u0440\u044B\u0442,
        \u043D\u0443\u0436\u043D\u0430 \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430."
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: -1
      completeSounds:
      - clip: {fileID: 8300000, guid: fc5bdd2e794be7940b7a2916675f136d, type: 3}
        authorIndex: 0
      - clip: {fileID: 8300000, guid: 86e28a85ef608a043aa601bd9a7eab1a, type: 3}
        authorIndex: 1
      - clip: {fileID: 8300000, guid: 86e28a85ef608a043aa601bd9a7eab1a, type: 3}
        authorIndex: 2
    - showTime: 2
      text: "\u2014 \u041A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430? \u0410
        \u0435\u0441\u043B\u0438 \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C
        \u043F\u0430\u0440\u0442\u0431\u0438\u043B\u0435\u0442?"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: 2
      completeSounds: []
    shortLevelName: "\u041F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C"
    completeText: "\u041D\u0443\u0436\u0435\u043D \u043A\u043B\u044E\u0447"
    completeTextColor: {r: 1, g: 0.07603065, b: 0, a: 1}
    onlyShowText: 0
    startImmediately: 0
  - selectable: {fileID: 7423991045303590523}
    status: 0
    readyWhen:
    - itemIndex: 13
      requiredStatus: 3
      isMain: 0
      atLeast: 0
    doneWhen: []
    textToShow:
    - showTime: 2
      text: "\u0412\u0440\u043E\u0434\u0435 \u043D\u0443\u0436\u043D\u0430\u044F
        \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430, \u0442\u043E\u043B\u044C\u043A\u043E
        \u0431\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0430."
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
      author: -1
      completeSounds:
      - clip: {fileID: 8300000, guid: 55f8f9776f0a2ec4dbfb6f42583ea8f1, type: 3}
        authorIndex: 0
      - clip: {fileID: 8300000, guid: e85a7d6fc8b74a049866cb4ce2d988af, type: 3}
        authorIndex: 1
      - clip: {fileID: 8300000, guid: e85a7d6fc8b74a049866cb4ce2d988af, type: 3}
        authorIndex: 2
    - showTime: 2
      text: "\u2014 \u041F\u043E\u0434\u043E\u0448\u043B\u0430! \u0412\u043E\u0442
        \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F
        \u0441\u0438\u0441\u0442\u0435\u043C\u0430: \u043E\u0434\u0438\u043D \u043A\u043B\u044E\u0447
        \u2014 \u0438 \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439
        \u0432\u0435\u0441\u044C \u043A\u043E\u0441\u043C\u043E\u0441"
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
