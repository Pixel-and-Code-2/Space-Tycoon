      - clip: {fileID: 8300000, guid: 49c5754adaa4f1049a360c68830de8c0, type: 3}
        authorIndex: 2
    - showTime: 0
      text: "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0435\u0433\u043E
