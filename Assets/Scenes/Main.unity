  calculateWalkDistance:
    formula: "(g_IsStepByStep < 0.5 ? 9999 :\n(c_AttackerMovesToSkip > 0 ? -1 :\n((c_AttackerShotAmount
      > 0 && c_AttackerIsShootOnMove < 0.5) ? -2 :\n((c_AttackerMeleeAmount > 0 &&
      c_AttackerIsShootOnMove < 0.5) ? -3 :\nMath.Max(0, \ni_SPD - c_AttackerWalkedDistance\n)))))"
    instruction: "Type a mathematical expression using common '+', '-', '*', '/',
