    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[8].textToShow.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[9].textToShow.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[0].textToShow.Array.data[1].text
      value: "\u041F\u0440\u043E\u0432\u043E\u0434\u0430 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u044B,
        \u043D\u043E \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u0442\u0435\u0445\u043D\u0438\u043A\u0430
        \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0435 \u043D\u0430
        \u043C\u043E\u043B\u0438\u0442\u0432\u0430\u0445, \u0430 \u043D\u0430 \u0438\u0437\u043E\u043B\u0435\u043D\u0442\u0435
        \u0438 \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[1].textToShow.Array.data[1].text
      value: "\u042D\u0442\u043E \u043D\u0435 \u043F\u043E\u0447\u0435\u0440\u043A,
        \u0442\u043E\u0432\u0430\u0440\u0438\u0449, \u0430 \u0448\u0438\u0444\u0440:
        \u0434\u0430\u0436\u0435 \u0426\u0420\u0423 \u0440\u0435\u0448\u0438\u0442,
        \u0447\u0442\u043E \u043A\u043E\u0441\u043C\u043E\u0441 \u0448\u0438\u043F\u0438\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[2].textToShow.Array.data[1].text
      value: "\u0410 \u044D\u0442\u043E \u043D\u0435 \u0431\u0438\u043B\u044C\u044F\u0440\u0434,
        \u044D\u0442\u043E \u0442\u0440\u0435\u043D\u0430\u0436\u0451\u0440 \u0434\u043B\u044F
        \u043D\u0435\u0432\u0435\u0441\u043E\u043C\u043E\u0441\u0442\u0438! \u0423\u0447\u0438\u043C\u0441\u044F
        \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
        \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E \u2014 \u0447\u0442\u043E\u0431\u044B
        \u0431\u043E\u043B\u0442 \u043D\u0435 \u0432 \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0442\u043E\u0440,
        \u0430 \u0432 \u0433\u0430\u0439\u043A\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[3].textToShow.Array.data[1].text
      value: "\u042D\u0442\u043E \u043D\u0435 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435
        \u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u044B, \u0442\u043E\u0432\u0430\u0440\u0438\u0449,
        \u0430 \u0432\u044B\u0445\u043E\u0434 \u043D\u0430 \u043E\u0440\u0431\u0438\u0442\u0443
        \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0451!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[4].textToShow.Array.data[1].text
      value: "\u0410 \u043D\u0435\u0432\u0435\u0441\u043E\u043C\u043E\u0441\u0442\u044C,
        \u0442\u043E\u0432\u0430\u0440\u0438\u0449, \u0432 \u043F\u043B\u0430\u043D
        \u043D\u0435 \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u0430. \u041F\u0435\u0440\u0435\u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435
        \u0441 \u0433\u0440\u0443\u0437\u043E\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[5].textToShow.Array.data[1].text
      value: "\u041D\u0438\u0447\u0435\u0433\u043E! \u041C\u044B \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u043C
        \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[6].textToShow.Array.data[1].text
      value: "\u041D\u0435 \u0434\u0432\u0435\u0440\u044C, \u0430 \u0448\u043B\u044E\u0437!
        \u0411\u0435\u0437 \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0433\u043E
        \u043F\u0443\u0442\u0438 \u043D\u0435 \u043E\u0431\u043E\u0439\u0442\u0438\u0441\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[7].textToShow.Array.data[1].text
      value: "\u042D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u043D\u0430\u0443\u043A\u0430,
        \u0442\u043E\u0432\u0430\u0440\u0438\u0449: \u0413\u0430\u0433\u0430\u0440\u0438\u043D
        \u043A\u043E\u0441\u043C\u043E\u0441 \u043E\u0442\u043A\u0440\u044B\u043B,
        \u0430 \u043C\u044B \u0435\u0433\u043E \u0442\u0435\u043F\u0435\u0440\u044C
        \u043F\u043E\u0434 \u0434\u0430\u0447\u0438 \u043E\u0441\u0432\u0430\u0438\u0432\u0430\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[8].textToShow.Array.data[1].text
      value: "\u041F\u043E\u043B\u0435\u0436\u0438 \u043C\u0438\u043D\u0443\u0442\u043A\u0443,
        \u0442\u043E\u0432\u0430\u0440\u0438\u0449. \u0420\u043E\u0434\u0438\u043D\u0430
        \u0437\u043E\u0432\u0451\u0442, \u043D\u043E \u043A\u043E\u0432\u0451\u0440
        \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0432\u044F\u0437\u044C \u043B\u0443\u0447\u0448\u0435
        \u0426\u0423\u041F\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
      propertyPath: sideTaskScenario.Array.data[9].textToShow.Array.data[1].text
      value: "\u0412\u0441\u0451 \u043F\u043E \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439
        \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0435:
        \u0432\u0430\u043B\u0438\u0434\u043E\u043B \u2014 \u0447\u0442\u043E\u0431\u044B
        \u043D\u0435 \u043F\u0430\u043D\u0438\u043A\u043E\u0432\u0430\u0442\u044C,
        \u0443\u0433\u043E\u043B\u044C \u2014 \u0435\u0441\u043B\u0438 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
        \u0437\u0430\u043F\u0430\u043D\u0438\u043A\u0443\u0435\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 5225966698374250366, guid: b08fce61082e5834d81eb87025ea89ba, type: 3}
