    textToShow:
    - showTime: 2
      text: "\u041F\u0440\u043E\u0432\u043E\u0434\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
        \u0442\u0430\u043A, \u0441\u043B\u043E\u0432\u043D\u043E \u0438\u0445 \u043A\u0442\u043E-\u0442\u043E
        \u043F\u0440\u043E\u0433\u0440\u044B\u0437. \u0410 \u043D\u0430\u0441 \u0442\u0430\u043A
        \u043D\u0438\u043A\u0442\u043E \u0438 \u043D\u0435 \u043F\u0440\u0438\u0431\u044B\u043B
        \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C. \u0421\u0442\u043E\u0438\u0442
        \u0431\u044B\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435,
        \u0440\u044F\u0434\u043E\u043C \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
        \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C. \u041D\u0443\u0436\u043D\u043E
        \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435
