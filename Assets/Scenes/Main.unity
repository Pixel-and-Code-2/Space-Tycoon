    textToShow:
    - showTime: 2
      text: "\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043C\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u0431 \u0441 \u0437\u0435\u043C\u043B\u0451\u0439.
        \u0418 \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430 \u0435\u0449\u0451.
        \u0412\u044B \u0447\u0442\u043E, \u0445\u043E\u0442\u0435\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u043C
        \u0434\u0435\u043B\u043E\u043C \u0432 \u043A\u043E\u0441\u043C\u043E\u0441\u0435
        \u043D\u0435 \u043D\u0430\u0443\u043A\u0443 \u0434\u0432\u0438\u0433\u0430\u0442\u044C,
        \u0430 \u043E\u043A\u0443\u0447\u0438\u0432\u0430\u0442\u044C \u0433\u0440\u044F\u0434\u043A\u0438?
        \u0418\u0434\u0435\u044F \u043A\u0440\u0435\u043F\u043A\u0430\u044F, \u043A\u0430\u043A
        \u0441\u0430\u043C \u043A\u043B\u0443\u0431\u0435\u043D\u044C, \u043D\u043E
        \u0441\u043C\u044B\u0441\u043B\u0430 \u0432 \u043D\u0435\u0439 \u043C\u0430\u043B\u043E\u0432\u0430\u0442\u043E."
