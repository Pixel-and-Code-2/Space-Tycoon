      text: "\u0414\u0430\u0436\u0435 \u0432\u0434\u0430\u043B\u0438 \u043E\u0442
        \u0420\u043E\u0434\u0438\u043D\u044B \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440
        \u0418\u043B\u044C\u0438\u0447 \u0438 \u0418\u043E\u0441\u0438\u0444 \u0412\u0438\u0441\u0441\u0430\u0440\u0438\u043E\u043D\u043E\u0432\u0438\u0447,
        \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
        \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u0430\u0440\u0442\u0438\u044F
        \u043D\u0430\u043C\u0438 \u0433\u043E\u0440\u0434\u0438\u0442\u0441\u044F.
        \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C
        \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C \u0438 \u043C\u044B \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F
        \u043D\u0430 \u0420\u043E\u0434\u0438\u043D\u0443."
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
    shortLevelName: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0441\u0442\u0430\u0442\u0443\u044E"
    completeText: 
    completeTextColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  - selectable: {fileID: 675672623}
    status: 0
    readyWhen:
    - itemIndex: 6
      requiredStatus: 3
      isMain: 1
      atLeast: 0
    doneWhen:
    - itemIndex: 8
      requiredStatus: 3
      isMain: 1
      atLeast: 0
    textToShow:
    - showTime: 2
      text: "\u0422\u0443\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
        \u0432\u0438\u0441\u0438\u0442 \u043D\u0435\u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
        \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442 \u044D\u043A\u0438\u043F\u0430\u0436\u0430
        \u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u041E\u043D\u0438 \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
        \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u043F\u043E\u043C\u043E\u0449\u0438,
        \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
        \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
        \u043E\u043F\u0430\u0441\u043D\u044B\u043C, \u043D\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438.  "
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
    shortLevelName: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440"
    completeText: 
    completeTextColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  - selectable: {fileID: 64067093}
    status: 0
    readyWhen:
    - itemIndex: 6
      requiredStatus: 3
      isMain: 1
      atLeast: 0
    doneWhen:
    - itemIndex: 8
      requiredStatus: 3
      isMain: 1
      atLeast: 0
    textToShow:
    - showTime: 2
      text: "\u0410\u043F\u0442\u0435\u0447\u043A\u0430? \u0411\u044B\u043B\u043E
        \u0431\u044B \u043F\u043E\u043B\u0435\u0437\u043D\u043E, \u043D\u043E \u0443\u0432\u044B
        \u043E\u043D\u0430 \u043F\u0443\u0441\u0442\u0430. \u041C\u043E\u0436\u0435\u0442
        \u0437\u043D\u0430\u043D\u0438\u0439 \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u044F\u043D
        \u0445\u0432\u0430\u0442\u0438\u043B\u043E, \u0447\u0442\u043E\u0431\u044B
        \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432
        \u0442\u043E\u043C, \u043A\u0430\u043A \u0435\u0439 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F? "
      shown: 0
      showOnce: 1
      showOnlyOnStepByStep: 0
    shortLevelName: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0430\u043F\u0435\u0447\u043A\u0443"
