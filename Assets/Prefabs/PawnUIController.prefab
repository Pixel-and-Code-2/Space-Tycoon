        \u043F\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0443 <sprite=3> \u0438
        \u0432 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043D\u043E\u043C
