    - target: {fileID: 9035555274462229432, guid: b33687fcd6d3b954dbf1c907b909e6df, type: 3}
      propertyPath: m_text
      value: "    \u0414\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
