    - showTime: 2
      text: "\u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F.
        \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
        \u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435\u2026\u0427\u0451\u0440\u0442!
